{
  "name": "privai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "bench": "tsx scripts/benchmark.ts",
    "ci": "npm run lint && npm run typecheck && npm run test:coverage && npm run build && npm run bench -- --mock --runs 2",
    "verify": "npm run ci && npm run test:e2e"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@mlc-ai/web-llm": "^0.2.86",
    "@serwist/next": "^9.5.4",
    "@serwist/precaching": "^9.5.4",
    "@serwist/sw": "^9.5.4",
    "@types/prismjs": "^1.26.6",
    "clsx": "^2.1.1",
    "fflate": "^0.8.2",
    "framer-motion": "^12.33.0",
    "idb": "^8.0.3",
    "lucide-react": "^0.563.0",
    "next": "16.1.6",
    "pdfjs-dist": "^5.4.530",
    "prismjs": "^1.30.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
